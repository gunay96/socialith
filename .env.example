# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://socialith:socialith@localhost:5432/socialith?schema=public"

# ── Redis / Queue ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── App URLs ──────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL is also used by the API to restrict CORS to this
# origin. In development it's optional (falls back to localhost:3000).
# In production it is REQUIRED and must NOT be a localhost URL — the app
# will refuse to boot otherwise. See @socialith/config.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Read by apps/web (Phase 02D) — the API's origin only, no "/api" suffix
# and no trailing slash; apps/web/src/lib/api.ts appends the exact
# "/api/..." paths apps/api's routers already mount. Next.js inlines
# NEXT_PUBLIC_* vars at build time, so this must be set wherever
# `next build`/`next dev` runs, not just where the API runs.
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_PORT=4000
WORKER_PORT=4100
NODE_ENV="development"

# ── Auth / Sessions ───────────────────────────────────────
SESSION_SECRET="replace-with-a-long-random-string"
JWT_SECRET="replace-with-a-long-random-string"
PASSWORD_HASH_ALGORITHM="scrypt"

# ── Email — actually read/validated by @socialith/config ─────────────
# Selects the EmailService implementation (see
# apps/api/src/lib/email/email.service.ts). "console" (logs the email
# instead of sending it — no real provider is connected) is the only
# supported value today; this is where a real provider's name goes once
# one is wired in.
EMAIL_PROVIDER="console"

# ── Storage (Cloudflare R2 / S3-compatible) — Phase 10 ─────────────────
# Real production object storage (packages/video-engine's R2AssetStorage).
# Optional: without these, apps/api/apps/worker use the real local-
# filesystem backend (LOCAL_STORAGE_DIR below) instead — never a
# fabricated upload success either way. See docs/setup-r2.md.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="socialith"
# Optional. Set only if the bucket is public or CDN-fronted with a stable
# base URL — leave unset (the default) to have every download URL be a
# real time-limited presigned R2 GET URL instead (favoring signed access
# over an open bucket, per this phase's security requirements).
R2_PUBLIC_URL=""

# ── TikTok API — real OAuth connect (apps/api/src/oauth) + publishing
# token refresh (apps/worker/src/publishing). See docs/setup-tiktok.md
# for where to get these from TikTok's developer console. REDIRECT_URI
# is optional — defaults to this API's own real callback route
# (API_PUBLIC_URL + /api/oauth/tiktok/callback); set it explicitly only
# if the app you registered with TikTok uses a different one.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""

# ── Meta (Instagram) API — real OAuth connect + publishing token
# refresh. See docs/setup-meta.md. REDIRECT_URI optional, same default
# pattern as TikTok above (…/api/oauth/instagram/callback).
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""

# ── Google (YouTube Data API) — real OAuth connect + publishing token
# refresh. See docs/setup-youtube.md. REDIRECT_URI optional, same
# default pattern as above (…/api/oauth/youtube/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ── Monitoring — reserved for Phase 11 (Sentry), not read/validated yet ──
SENTRY_DSN=""

# ── AI Provider (captions/hashtags) — Phase 07 ────────────────────────
# Read by apps/worker's content-generation processor. Without a key,
# generation jobs legitimately fail with a clear "provider not
# configured" error — no fake success is produced. BASE_URL/MODEL assume
# an OpenAI-compatible chat-completions API; override for a different
# provider with the same request/response shape.
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER_MODEL="gpt-4o-mini"
# Phase 10: real request timeout (was previously unbounded — a hung
# request could hold a worker slot forever). Milliseconds.
AI_PROVIDER_TIMEOUT_MS="30000"
# Phase 10: optional real cost tracking. Only takes effect when BOTH are
# set, to your provider's actual current per-1k-token pricing — without
# them, real token usage (when the provider reports it) is still recorded,
# just without a derived dollar estimate. Never guessed/hardcoded.
AI_PROVIDER_COST_PER_1K_PROMPT_TOKENS_USD=""
AI_PROVIDER_COST_PER_1K_COMPLETION_TOKENS_USD=""

# ── Local asset storage / video render — Phase 07 ─────────────────────
# The real, credential-free storage backend this phase ships (see
# packages/video-engine) — not a stand-in for R2 above, a genuine
# implementation apps/api serves at API_PUBLIC_URL + "/media". Both
# default sensibly (a per-OS temp dir; http://localhost:API_PORT) and
# don't need to be set for local/dev use.
LOCAL_STORAGE_DIR=""
API_PUBLIC_URL=""
# Only needed if `ffmpeg` isn't already on PATH.
FFMPEG_PATH="ffmpeg"

# ── Token encryption (platform_connections at rest) — actually read/validated
# by @socialith/config since Phase 04 (packages/auth/src/token-crypto.ts,
# AES-256-GCM). Must be exactly 64 hex characters (32 bytes), e.g. generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters-32-bytes"

# ── Per-queue rate limits — Phase 10 §15 ───────────────────────────────
# BullMQ's own Worker `limiter` option (no new rate-limiting library) —
# real caps on how many jobs each queue starts per window, tuned per
# provider. Defaults are conservative starting points; raise them once you
# know your actual TikTok/Meta/Google app tier's real limits.
AI_PROVIDER_RATE_LIMIT_MAX="20"
AI_PROVIDER_RATE_LIMIT_DURATION_MS="60000"
PUBLISHING_RATE_LIMIT_MAX="30"
PUBLISHING_RATE_LIMIT_DURATION_MS="60000"
ANALYTICS_SYNC_RATE_LIMIT_MAX="60"
ANALYTICS_SYNC_RATE_LIMIT_DURATION_MS="60000"
TOKEN_REFRESH_RATE_LIMIT_MAX="30"
TOKEN_REFRESH_RATE_LIMIT_DURATION_MS="60000"
