# MySQL 8.4 settings for Socialith on a 4 vCPU / 8 GB VPS shared with the
# api, worker (FFmpeg) and web. A STARTING POINT, not tuned under load —
# revisit after real traffic (docs/OPERATIONS_RUNBOOK.md §Monitoring).
[mysqld]
# Characters and comparisons — must match the migration's per-table collation.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Keep the strict default; lossy implicit conversions are bugs, not features.
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Memory: ~1 GiB buffer pool leaves room for the other services. Raise it only
# if you also raise the container's mem_limit.
innodb_buffer_pool_size = 1G
innodb_redo_log_capacity = 512M
innodb_flush_log_at_trx_commit = 1
max_connections = 100
skip_name_resolve = ON

# Binary logging stays on (default in 8.x) with a 7-day window: it is what
# allows point-in-time recovery between nightly dumps.
binlog_expire_logs_seconds = 604800

# Slow-query visibility for the monitoring runbook.
slow_query_log = ON
long_query_time = 1

# The X protocol is unused.
mysqlx = OFF
