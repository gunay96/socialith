# Socialith VPS configuration — copy to infra/vps/.env (git-ignored) and fill
# EVERY value. This file holds placeholders only; real values never go in Git.
#
# Passwords/secrets: use hex so they need no URL-encoding inside DATABASE_URL /
# REDIS_URL. Generate each one separately:
#   openssl rand -hex 24      # passwords
#   openssl rand -hex 32      # SESSION_SECRET, JWT_SECRET, TOKEN_ENCRYPTION_KEY (64 hex chars)

# --- Public address ---------------------------------------------------------
# The domain (no scheme). Its DNS record must point at this VPS — created by
# you at your DNS provider; nothing in this repo touches DNS.
APP_DOMAIN=app.example.com
# Let's Encrypt contact e-mail (certificate expiry notices).
ACME_EMAIL=ops@example.com

# --- MySQL ------------------------------------------------------------------
MYSQL_DATABASE=socialith
MYSQL_ROOT_PASSWORD=change-me
MYSQL_APP_USER=socialith_app
MYSQL_APP_PASSWORD=change-me
MYSQL_MIGRATE_USER=socialith_migrate
MYSQL_MIGRATE_PASSWORD=change-me
MYSQL_BACKUP_USER=socialith_backup
MYSQL_BACKUP_PASSWORD=change-me

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- Application secrets ----------------------------------------------------
SESSION_SECRET=change-me
JWT_SECRET=change-me
# AES-256 key encrypting stored OAuth tokens — 64 hex chars. Losing it makes
# every stored credential unreadable; back it up separately from the database.
TOKEN_ENCRYPTION_KEY=change-me

# --- Scheduling safety (defaults shown) --------------------------------------
# A scheduled item more than this many minutes overdue is HELD, never auto-published.
SCHEDULE_STALE_AFTER_MINUTES=30
SCHEDULING_RECONCILE_INTERVAL_SECONDS=60
PUBLISHING_STUCK_AFTER_MINUTES=20
PUBLISHING_RECOVERY_MAX_AGE_HOURS=24

# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Optional integrations (leave empty = not configured) ---------------------
EMAIL_PROVIDER=console
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=socialith
R2_PUBLIC_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
SENTRY_DSN=

# --- Upload-Post (Phase 2) -----------------------------------------------------
# API key from your Upload-Post dashboard. SERVER-SIDE ONLY - type it into the real .env
# yourself; never commit it, never paste it into chat. Empty = integration 'not configured'.
UPLOAD_POST_API_KEY=
UPLOAD_POST_BASE_URL=
# Webhook signing secret shown in Upload-Post (Notifications). Empty = webhook route answers 503.
UPLOAD_POST_WEBHOOK_SECRET=
UPLOAD_POST_WEBHOOK_SECRET_PREVIOUS=
# Needed only if this deployment has more than one organization.
UPLOAD_POST_ORGANIZATION_ID=
UPLOAD_POST_SYNC_INTERVAL_MINUTES=30
# Hybrid scheduling hand-off to Upload-Post's own scheduler: OFF by default. It may only be enabled after a SEPARATE live
# verification (docs/UPLOAD_POST_TESTING.md section 5) and the owner's explicit approval. Enabling needs BOTH switches below;
# ENABLED=true without OWNER_APPROVED=true refuses to boot. Socialith's database stays the master schedule either way.
UPLOAD_POST_SCHEDULE_HANDOFF_ENABLED=false
UPLOAD_POST_HANDOFF_OWNER_APPROVED=false
UPLOAD_POST_SCHEDULE_HANDOFF_WINDOW_HOURS=48
LOG_LEVEL=info
