{
  "name": "@socialith/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live-readonly": "vitest run --config vitest.live.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@socialith/auth": "workspace:*",
    "@socialith/config": "workspace:*",
    "@socialith/database": "workspace:*",
    "@socialith/types": "workspace:*",
    "@socialith/upload-post": "workspace:*",
    "@socialith/video-engine": "workspace:*",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.0",
    "pino": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vite-tsconfig-paths": "^4.3.2",
    "pino-pretty": "^11.2.0"
  }
}
